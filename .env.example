NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
DATABASE_PATH=.runtime/aurie.sqlite
UPLOAD_DIR=.runtime/uploads
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SESSION_HOURS=168
RESERVATION_MINUTES=20
DELIVERY_FEE_RWF=2500
FREE_DELIVERY_ABOVE_RWF=120000
# Empty means all Rwanda provinces; coverage/fees require merchant confirmation.
DELIVERY_PROVINCES=
PAYMENT_ENVIRONMENT=test
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_WEBHOOK_SECRET=
FLW_WEBHOOK_AUTH=legacy
# Required to verify merchant identity when payments are enabled.
FLW_ACCOUNT_ID=
# Only enable methods activated for your merchant: card,mobile_money
PAYMENT_METHODS=
PAYMENT_REDIRECT_URL=http://localhost:5173/account
# Brevo credentials are server-only. Configure a verified sender in Brevo.
BREVO_API_KEY=
EMAIL_SENDER_EMAIL=
EMAIL_SENDER_NAME=AURIE
DOCS_ENABLED=true
